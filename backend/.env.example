# Copy this file to backend/.env and fill in real values.
# backend/.env is gitignored so secrets never reach GitHub.

PORT=5050
DATA_SOURCE=SIMULATOR

# --- MySQL / MariaDB connection (used by both the Node backend and Python simulator) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=solar
DB_PASSWORD=change_me
DB_NAME=solar_scada
DB_POOL_SIZE=10

# --- Auth (JWT) ---
# Generate a strong secret, e.g.:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_with_a_long_random_string
JWT_TTL=12h
ADMIN_PASSWORD=change_me

# --- Robot/hardware ingest (optional). If set, robots must send x-api-key: <value> ---
INGEST_API_KEY=

# --- External REST services (per-farm keys/tokens are stored in the DB, not here) ---
THINGSPEAK_BASE=https://api.thingspeak.com
BLYNK_BASE=https://blr1.blynk.cloud

# --- EMQX / MQTT (leave MQTT_URL blank to disable) ---
MQTT_URL=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_BASE_TOPIC=kleanobotics/robots
